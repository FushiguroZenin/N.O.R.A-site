# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only configuration. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NORA_VERIFY_WEBHOOK_SECRET=use_a_long_random_secret

# Optional email delivery via Resend. Without both values, NORA keeps using
# in-app notifications and safely skips sending provider email.
RESEND_API_KEY=re_your_resend_api_key
NORA_EMAIL_FROM=NORA <updates@your-verified-domain.example>
